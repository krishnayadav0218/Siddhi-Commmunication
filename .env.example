# Password required to log into /admin
ADMIN_PASSWORD=change-this-password

# Random long string used to sign admin session cookies (any long random text)
SESSION_SECRET=change-this-to-a-long-random-string

# GitHub Personal Access Token with "Contents: Read and write" permission on this repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The GitHub username or organization that owns the repo
GITHUB_OWNER=your-github-username

# The repository name
GITHUB_REPO=siddhi-communication

# Branch Vercel deploys from
GITHUB_BRANCH=main

# Path to the content file inside the repo (leave as-is unless you move it)
GITHUB_CONTENT_PATH=content/site-content.json

# Razorpay keys — required for the "Pay Online Now" cart checkout.
# Get these from the Razorpay Dashboard > Settings > API Keys.
# Without these set, the online-payment button shows a friendly error and
# customers can still order via the WhatsApp button, so this is optional.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
